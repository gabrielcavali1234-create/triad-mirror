PORT=3002
ANTHROPIC_API_KEY=

# Supabase (opcional no início — sem ele, cache de duplicados e gravação de custo ficam desligados)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Quantas chamadas à IA podem rodar ao mesmo tempo NESTE servidor.
# Se usar a mesma conta Anthropic da TRIAD, lembre que as duas somam no mesmo limite.
LIMITE_CHAMADAS_SIMULTANEAS=3

# Quantos pedaços de um mesmo PDF processar em paralelo
CONCORRENCIA_POR_DOCUMENTO=8

# Chave de acesso às rotas do Mirror (cabeçalho x-mirror-key). OBRIGATÓRIA:
# sem ela, as rotas de análise ficam bloqueadas. Use uma senha longa e aleatória.
MIRROR_ACCESS_KEY=

# SÓ PARA TESTE LOCAL: 1 = banco em memória e login com a MIRROR_ACCESS_KEY como senha.
# NUNCA ligar em produção.
MIRROR_MODO_DEV=
